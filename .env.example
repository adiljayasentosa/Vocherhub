NODE_ENV=development
PORT=3000

# --- Session cookie ---
SESSION_COOKIE_NAME=vh_session
# 5 days in ms (Firebase's max session cookie lifetime)
SESSION_MAX_AGE_MS=432000000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=8

# --- Dashboard ---
LOW_STOCK_THRESHOLD=50
RECENT_TRANSACTIONS_LIMIT=5

# --- Voucher Inventory (per-nominal, distinct from LOW_STOCK_THRESHOLD above) ---
LOW_STOCK_THRESHOLD_PER_NOMINAL=100

# --- Firebase Admin SDK (SECRET - from your service account JSON, Project Settings > Service Accounts > Generate new private key) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Firebase client config (NOT secret - from Project Settings > General > Your apps) ---
FIREBASE_CLIENT_API_KEY=
FIREBASE_CLIENT_AUTH_DOMAIN=
FIREBASE_CLIENT_STORAGE_BUCKET=
FIREBASE_CLIENT_MESSAGING_SENDER_ID=
FIREBASE_CLIENT_APP_ID=
